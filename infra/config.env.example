# Copy to infra/config.env and fill in. infra/config.env is git-ignored.

PROJECT_ID="tu-proyecto-gcp"          # gcloud projects list
REGION="us-central1"                  # Cloud Run domain mappings are supported here
SERVICE="adrgarcia-web"               # Cloud Run service name
REPO="web"                            # Artifact Registry repository
DOMAIN="adrgarcia.com"                # apex domain (registered at Hostinger)
DNS_ZONE="adrgarcia-com"              # Cloud DNS managed zone name

# GitHub repository that holds this project (for the CI/CD trigger)
GITHUB_OWNER="tu-usuario-github"
GITHUB_REPO="adrian-garcia-webpage"
BRANCH="main"
GH_CONNECTION="github"                # Cloud Build 2nd-gen connection name

